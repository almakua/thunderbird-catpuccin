/* catppuccin $flavor_name readable with $accent_name accent
   generated by build.py, so edit the templates instead of this file */

/* internal pages like settings, add-ons and about:3pane follow the palette too */
@-moz-document url-prefix("about:"), url-prefix("chrome:") {
$tokens
}

/* makes the variables available inside message bodies as well */
:root {
$vars
}

/* quotes get a thicker border with one palette color per level
   we only touch the border, so HTML mail keeps its own text colors */
body blockquote[type="cite"] {
  border-inline-start: 3px solid var(--ctp-role-quote1) !important;

  & blockquote[type="cite"] {
    border-inline-start-color: var(--ctp-role-quote2) !important;

    & blockquote[type="cite"] {
      border-inline-start-color: var(--ctp-role-quote3) !important;

      & blockquote[type="cite"] {
        border-inline-start-color: var(--ctp-role-quote4) !important;

        & blockquote[type="cite"] {
          border-inline-start-color: var(--ctp-role-quote5) !important;
        }
      }
    }
  }
}
$plain_text
$force_html

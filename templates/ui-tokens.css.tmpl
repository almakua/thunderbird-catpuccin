/* catppuccin $flavor_name palette and roles */
:root {
$vars
}

/* thunderbird design tokens remapped to the palette, they drive the whole UI
   so overriding them holds up much better than chasing selectors */
:root {
  color-scheme: $scheme !important;

  --layout-background-0: var(--ctp-base) !important;
  --layout-background-1: var(--ctp-mantle) !important;
  --layout-background-2: var(--ctp-surface0) !important;
  --layout-background-3: var(--ctp-role-selected-unfocused) !important;
  --layout-background-4: var(--ctp-surface2) !important;
  --layout-color-0: var(--ctp-role-text) !important;
  --layout-color-1: var(--ctp-role-text) !important;
  --layout-color-2: var(--ctp-role-secondary) !important;
  --layout-color-3: var(--ctp-role-muted) !important;
  --layout-border-0: var(--ctp-surface0) !important;
  --layout-border-1: var(--ctp-surface1) !important;
  --layout-border-2: var(--ctp-surface2) !important;

  --selected-item-color: var(--ctp-role-sel-bg) !important;
  --selected-item-text-color: var(--ctp-role-sel-text) !important;
  --focus-outline-color: var(--ctp-role-indicator) !important;
  --new-folder-color: var(--ctp-role-new) !important;

  /* message list, table view */
  --tree-view-bg: var(--ctp-base) !important;
  --tree-view-color: var(--ctp-role-text) !important;
  --tree-view-header-hover-bg: var(--ctp-role-hover) !important;
  --tree-view-header-hover-active-bg: var(--ctp-role-selected-unfocused) !important;
  --unread-color: var(--ctp-role-text) !important;
  --listbox-hover: var(--ctp-role-hover) !important;
  --listbox-selected-bg: var(--ctp-role-selected-unfocused) !important;
  --listbox-focused-selected-bg: var(--ctp-role-sel-bg) !important;
  --listbox-selected-color: var(--ctp-role-sel-text) !important;
  --listbox-focused-selected-color: var(--ctp-role-sel-text) !important;
  --list-item-min-height: ${row_min_height}px !important;
  --thread-pane-unread-fill: var(--ctp-role-indicator) !important;
  --thread-pane-unread-stroke: var(--ctp-role-indicator) !important;

  /* message list, cards view */
  --tree-pane-background: var(--ctp-mantle) !important;
  --tree-card-background: var(--ctp-base) !important;
  --tree-card-border: var(--ctp-surface0) !important;
  --tree-card-border-hover: var(--ctp-surface2) !important;
  --tree-card-border-focus: var(--ctp-role-indicator) !important;
  --tree-card-background-current: var(--ctp-role-hover) !important;
  --tree-card-background-selected: color-mix(in srgb, var(--ctp-role-sel-bg) 22%, var(--ctp-base)) !important;
  --tree-card-background-selected-current: color-mix(in srgb, var(--ctp-role-sel-bg) 30%, var(--ctp-base)) !important;
  --tree-card-border-selected: var(--ctp-role-indicator) !important;
  --tree-card-background-current-unfocused: var(--ctp-role-hover) !important;
  --tree-card-background-selected-unfocused: var(--ctp-role-selected-unfocused) !important;
  --tree-card-background-selected-current-unfocused: var(--ctp-role-selected-unfocused) !important;
  --tree-card-background-selected-current-unfocused-hover: var(--ctp-role-hover) !important;
  --tree-card-border-selected-unfocused: var(--ctp-surface2) !important;

  /* folder pane */
  --treeitem-background-hover: var(--ctp-role-hover) !important;
  --treeitem-background-selected: var(--ctp-role-selected-unfocused) !important;
  --treeitem-background-active: var(--ctp-role-sel-bg) !important;
  --treeitem-text-active: var(--ctp-role-sel-text) !important;
  --folderpane-unread-count-background: var(--ctp-role-sel-bg) !important;
  --folderpane-unread-count-text: var(--ctp-role-sel-text) !important;
  --folderpane-unread-new-count-background: var(--ctp-role-sel-bg) !important;
  --folderpane-total-count-background: var(--ctp-surface0) !important;
  --folderpane-total-count-text: var(--ctp-role-text) !important;

  /* message header labels at full opacity */
  --message-header-label-opacity: 1 !important;

  /* search fields */
  --search-bar-color: var(--ctp-role-text) !important;
  --search-bar-background: var(--ctp-base) !important;
  --search-bar-focus-background: var(--ctp-base) !important;
  --search-bar-border-color: var(--ctp-surface1) !important;
  --search-field-placeholder: var(--ctp-role-muted) !important;

  scrollbar-color: var(--ctp-surface2) transparent;
}

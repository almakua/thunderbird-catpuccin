/* catppuccin $flavor_name readable with $accent_name accent, generated by build.py so edit the templates instead
   needs toolkit.legacyUserProfileCustomizations.stylesheets set to true */

$tokens

/* message list */

/* unread rows get bold text and an accent bar, so you can spot them even without color */
[is="tree-view-table-body"] > .table-layout[data-properties~="unread"] {
  font-weight: 700;

  & > td:first-child {
    box-shadow: inset 3px 0 0 var(--ctp-role-indicator);
  }
}

.card-layout[data-properties~="unread"] .card-container {
  box-shadow: inset 3px 0 0 var(--ctp-role-indicator);
}

/* dates, sizes and accounts in secondary text, except on the selected row */
[is="tree-view-table-body"] > .table-layout:not(.selected) > :is(.datecol-column, .receivedcol-column, .sizecol-column, .accountcol-column, .locationcol-column) {
  color: var(--ctp-role-secondary);
}

.card-layout:not(.selected) .date {
  color: var(--ctp-role-secondary);
}

/* flagged messages get a red subject, except on the selected row */
[is="tree-view-table-body"] > .table-layout[data-properties~="flagged"]:not(.selected) > .subjectcol-column {
  color: var(--ctp-role-flagged);
}

/* thin separators help the eye follow each row */
[is="tree-view-table-body"] > .table-layout > td {
  border-block-end: 1px solid var(--ctp-surface0);
}

/* folder pane */

#folderTree li.unread > .container > .name {
  font-weight: 700;
}

#folderTree .folder-count-badge {
  padding: 1px 6px;
}

/* message header */

#expandedsubjectBox {
  font-size: 1.25em;
  line-height: 1.3;
}

.message-header-label {
  color: var(--ctp-role-secondary);
}

/* focus and text selection */

:is(#folderTree, [is="tree-view-table-body"]):focus-visible {
  outline: 2px solid var(--ctp-role-indicator) !important;
  outline-offset: -2px !important;
}

::selection {
  background-color: var(--ctp-role-sel-bg);
  color: var(--ctp-role-sel-text);
}
